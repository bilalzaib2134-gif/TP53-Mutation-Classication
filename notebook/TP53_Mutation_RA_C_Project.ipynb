        "    'TAD2':      (41,  67),\n",
        "    'Proline':   (68, 101),\n",
        "    'DBD':      (102, 292),\n",
        "    'Linker':   (293, 324),\n",
        "    'Tetra':    (325, 356),\n",
        "    'Regulatory':(357, 393),\n",
        "}\n",
        "\n",
        "HOTSPOT_CODONS = {175, 245, 248, 249, 273, 282}\n",
        "\n",
        "print(\"Settings ready.\")"
      ],
