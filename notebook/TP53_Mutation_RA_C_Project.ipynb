    {
      "cell_type": "code",
      "source": [
        "print(\"Loading ClinVar data...\")\n",
        "\n",
        "df_raw = pd.read_csv(\n",
        "    '/content/clinvar_result.txt',\n",
        "    sep='\\t',\n",
        "    low_memory=False\n",
        ")\n",
        "\n",
        "print(f\"File loaded: {len(df_raw)} variants\")\n",
        "print(\"\\nClassification breakdown:\")\n",
        "print(df_raw['Germline classification'].value_counts())"
      ],
